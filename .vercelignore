# =============================================
#  .vercelignore — Keep Vercel deploy UNDER 100MB
#  Vercel only serves STATIC frontend files.
#  The Flask backend runs locally via Cloudflare.
# =============================================

# ── Python backend (runs locally, NOT on Vercel) ──
backend/
*.py
*.pyc
__pycache__/
venv/
env/
.env
*.env
requirements.txt
runtime.txt
run.py
train_deberta_v3.py
fix_*.py
update_url.py
check_theme.py

# ── ML Models (huge, run locally) ──
models/
model_text_finetuned/
model_text_finetuned_BACKUP_roberta/
*.pth
*.pt
*.ckpt
*.keras
*.h5
*.onnx
*.onnx.data
*.pkl
*.bin
*.safetensors
*.npy
*.npz

# ── Datasets (training data, never needed on Vercel) ──
dataset/
dataset_image/
dataset_image_balanced/
dataset_image_expanded/
dataset_text/
dataset_document/
dataset_voice/
dataset_custom/
text_ai_results/

# ── Node / React dev (not needed — static files already compiled) ──
node_modules/
**/node_modules/
frontend/
.next/
package-lock.json

# ── Server infrastructure ──
server/
uploads/
recordings/
video_frames_temp/
cf_tunnel.log
users.db
*.db
*.sqlite
*.sqlite3

# ── Dev / build tooling ──
.git/
.github/
.agents/
.vscode/
*.log
*.exe
*.tmp
*.bat
*.ps1
Dockerfile
docker-compose.yml
Procfile
render.yaml

# ── Misc large files ──
*.zip
*.tar
*.tar.gz
*.mp4
*.mp3
*.wav
*.avi
*.mkv
